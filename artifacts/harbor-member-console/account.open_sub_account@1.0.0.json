{
  "schema_version": "1.0",
  "meta": {
    "id": "account.open_sub_account",
    "version": "1.0.0",
    "status": "draft",
    "summary": "Open a new sub-account for a member and return the confirmation number. The final confirmation is irreversible and requires human approval.",
    "app_profile": "harbor-member-console"
  },
  "inputs": [
    {
      "name": "member_id", "type": "string", "description": "5-digit member number",
      "sensitivity": "identifier", "pattern": "^\\d{5}$"
    },
    {
      "name": "account_type", "type": "string",
      "description": "Account type to open, as labelled in the dropdown",
      "sensitivity": "public", "required": false, "default": "Share Savings"
    },
    {
      "name": "deposit", "type": "money", "description": "Opening deposit, e.g. 100.00",
      "sensitivity": "financial", "pattern": "^\\d{1,7}(\\.\\d{2})?$"
    }
  ],
  "outputs": [
    {
      "name": "confirmation_number", "type": "string",
      "description": "Confirmation number of the opened account",
      "sensitivity": "identifier"
    }
  ],
  "steps": [
    {
      "id": "open_form",
      "intent": "Open the sub-account form for the member",
      "action": { "type": "navigate", "route": "/member/{{inputs.member_id}}/open-account" },
      "risk": "read_only",
      "expect": {
        "url": "/member/{{inputs.member_id}}/open-account",
        "visible": [ { "role": "cell", "name": "Account Type:" } ]
      },
      "outcomes": [ "member_not_found", "member_restricted" ]
    },
    {
      "id": "choose_account_type",
      "intent": "Choose the account type",
      "action": { "type": "select", "value": "{{inputs.account_type}}" },
      "risk": "reversible",
      "target": {
        "description": "Account Type dropdown",
        "locators": [
          { "strategy": "role_in_scope", "role": "combobox", "scope": { "role": "row", "name": "Account Type:" } },
          { "strategy": "nth_of_role", "role": "combobox", "index": 0 }
        ],
        "rationale": "Dropdown has no accessible name; anchored to its label's innermost row."
      }
    },
    {
      "id": "enter_deposit",
      "intent": "Enter the opening deposit",
      "action": { "type": "fill", "value": "{{inputs.deposit}}" },
      "risk": "reversible",
      "target": {
        "description": "Initial Deposit field",
        "locators": [
          { "strategy": "role_in_scope", "role": "textbox", "scope": { "role": "row", "name": "Initial Deposit ($):" } },
          { "strategy": "nth_of_role", "role": "textbox", "index": 0 }
        ],
        "rationale": "Field has no accessible name; anchored to its label's innermost row."
      }
    },
    {
      "id": "continue_to_review",
      "intent": "Continue to the review screen",
      "action": { "type": "click" },
      "risk": "reversible",
      "target": {
        "description": "Continue button",
        "locators": [ { "strategy": "role_name", "role": "button", "name": "Continue" } ],
        "rationale": "Button has its own accessible name."
      },
      "expect": {
        "url": "/member/{{inputs.member_id}}/open-account/review",
        "visible": [ { "role": "cell", "name": "Initial Deposit:" } ]
      },
      "outcomes": [ "deposit_below_minimum", "invalid_deposit" ]
    },
    {
      "id": "confirm_new_account",
      "intent": "Confirm the new account (irreversible: creates the account)",
      "action": { "type": "click" },
      "risk": "irreversible",
      "target": {
        "description": "Confirm button",
        "locators": [ { "strategy": "role_name", "role": "button", "name": "Confirm" } ],
        "rationale": "Button has its own accessible name."
      },
      "expect": {
        "url": "/member/{{inputs.member_id}}/open-account/done",
        "visible": [ { "role": "cell", "name": "Account Opened Successfully" } ]
      }
    },
    {
      "id": "read_confirmation_number",
      "intent": "Read the confirmation number",
      "action": { "type": "extract", "into": "confirmation_number", "parse": "text" },
      "risk": "read_only",
      "target": {
        "description": "Confirmation number",
        "locators": [ { "strategy": "labelled_value", "label": "Confirmation No.:" } ],
        "rationale": "Label/value pair with no column header: the cell immediately beside its label."
      }
    }
  ],
  "outcomes": {
    "member_not_found": {
      "code": "MEMBER_NOT_FOUND", "description": "No member exists with this ID.",
      "detect": { "text": "No member found with ID" }
    },
    "member_restricted": {
      "code": "MEMBER_RESTRICTED", "description": "The member's account requires supervisor access.",
      "detect": { "text": "supervisor access required" }
    },
    "deposit_below_minimum": {
      "code": "DEPOSIT_BELOW_MINIMUM", "description": "The deposit is below the minimum for this account type.",
      "detect": { "text": "Minimum opening deposit" }
    },
    "invalid_deposit": {
      "code": "INVALID_DEPOSIT", "description": "The application rejected the deposit amount.",
      "detect": { "text": "Initial deposit must be a dollar amount" }
    }
  },
  "success": { "outputs_present": [ "confirmation_number" ] },
  "provenance": {
    "discovered_by": "hand-authored for the human-handoff demonstration",
    "discovery_run_id": "none",
    "recorded_at": "2026-10-04T12:00:00Z",
    "goal": "Open a {{inputs.account_type}} sub-account for member {{inputs.member_id}} with an opening deposit of {{inputs.deposit}}"
  }
}