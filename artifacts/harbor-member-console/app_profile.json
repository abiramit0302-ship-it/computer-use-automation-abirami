{
  "schema_version": "1.0",
  "id": "harbor-member-console",
  "product_version": "4.x",
  "description": "Harbor Point Member Services Console: legacy server-rendered web app with table layouts and no test IDs.",
  "secrets": ["operator_user", "operator_password"],
  "sensitive_labels": ["Name:", "Date of Birth:", "SSN (last 4):"],
  "sign_on": {
    "route": "/login",
    "steps": [
      {
        "id": "enter_operator_id",
        "intent": "Type the operator ID",
        "action": { "type": "fill", "value": "{{secrets.operator_user}}" },
        "risk": "reversible",
        "target": {
          "description": "Operator ID text field",
          "locators": [
            { "strategy": "role_in_scope", "role": "textbox", "scope": { "role": "row", "name": "Operator ID:" } },
            { "strategy": "nth_of_role", "role": "textbox", "index": 0 }
          ],
          "rationale": "Field has no accessible name; anchored to its label's table row."
        }
      },
      {
        "id": "enter_password",
        "intent": "Type the operator password",
        "action": { "type": "fill", "value": "{{secrets.operator_password}}" },
        "risk": "reversible",
        "target": {
          "description": "Password field",
          "locators": [
            { "strategy": "role_in_scope", "role": "textbox", "scope": { "role": "row", "name": "Password:" } },
            { "strategy": "nth_of_role", "role": "textbox", "index": 1 }
          ],
          "rationale": "Field has no accessible name; anchored to its label's table row."
        }
      },
      {
        "id": "submit_sign_on",
        "intent": "Submit the sign-on form",
        "action": { "type": "click" },
        "risk": "reversible",
        "target": {
          "description": "Sign On button",
          "locators": [
            { "strategy": "role_name", "role": "button", "name": "Sign On" }
          ]
        }
      }
    ],
    "success": {
      "visible": [ { "role": "link", "name": "Sign off" } ]
    }
  },
  "interstitials": {
    "system_notice": {
      "description": "Maintenance notice overlay that blocks the page until acknowledged.",
      "detect": { "text": "System Notice" },
      "kind": "recoverable",
      "recovery": {
        "type": "dismiss",
        "target": {
          "description": "Acknowledge button on the notice",
          "locators": [
            { "strategy": "role_name", "role": "button", "name": "Acknowledge" }
          ]
        }
      }
    },
    "session_expired": {
      "description": "Session timed out and the app redirected to sign-on.",
      "detect": { "text": "Your session has expired" },
      "kind": "recoverable",
      "recovery": { "type": "reauthenticate" }
    },
    "core_unavailable": {
      "description": "The core banking system behind the console is down.",
      "detect": { "text": "Core system unavailable" },
      "kind": "hard_failure"
    }
  },
  "timing": {
    "action_timeout_ms": 5000,
    "navigation_timeout_ms": 10000,
    "max_recoveries_per_step": 2
  }
}